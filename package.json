{
  "name": "@ontopic/viz",
  "version": "1.0.0",
  "description": "Component registry for data visualization - install components directly into your project",
  "bin": {
    "viz": "./cli/index.js"
  },
  "files": [
    "cli",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preview:dev": "vite --host 0.0.0.0",
    "preview:build": "vite build",
    "preview:serve": "vite preview --host 0.0.0.0",
    "clean": "rm -rf preview-dist",
    "typecheck": "tsc --noEmit",
    "theme:check": "tsc -p tsconfig.viz-check.json",
    "theme:css": "tsx registry/theme/generate-css.ts",
    "test": "vitest run"
  },
  "keywords": [
    "data visualization",
    "react",
    "observable-plot",
    "recharts",
    "charts",
    "graphs",
    "components"
  ],
  "author": "Ontopic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ctzn-pub/viz-registry.git"
  },
  "peerDependencies": {
    "@observablehq/plot": "^0.6.0",
    "d3-geo": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-shape": "^3.0.0",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^2.15.0",
    "topojson-client": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "@observablehq/plot": {
      "optional": false
    },
    "lucide-react": {
      "optional": false
    },
    "recharts": {
      "optional": false
    },
    "maplibre-gl": {
      "optional": true
    },
    "pmtiles": {
      "optional": true
    },
    "d3-geo": {
      "optional": true
    },
    "topojson-client": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.17",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/topojson-client": "^3.1.5",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3",
    "vite": "6.4.1",
    "vitest": "^3.2.4"
  },
  "sideEffects": false
}
